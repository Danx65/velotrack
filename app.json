{
  "expo": {
    "name": "VELOTRACK",
    "slug": "velotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "velotrack",
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "web": {
      "bundler": "metro",
      "name": "VELOTRACK",
      "shortName": "VELOTRACK",
      "description": "Gestão Técnica de Oficina Mecânica",
      "lang": "pt-BR",
      "themeColor": "#06060C",
      "backgroundColor": "#06060C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.velotrack.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.velotrack.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para enviar imagens dos serviços.",
          "cameraPermission": "O app precisa acessar sua câmera para fotografar os serviços."
        }
      ],
      "expo-sqlite"
    ]
  }
}
